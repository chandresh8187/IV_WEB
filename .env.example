# Optional public build-time settings. Leave unset to use automatic defaults:
# npm run dev -> localhost:5000; npm run build -> https://app.ivsquarestructure.com.
# API roots must end in /api. Never put server secrets in VITE_* variables.
# VITE_API_BASE_URL=https://app.ivsquarestructure.com/api
# VITE_UNIT1_API_BASE_URL=https://app.ivsquarestructure.com/api
# VITE_SOCKET_URL=https://app.ivsquarestructure.com
# Unit 1 QR address; defaults to the current web origin plus /unit1.
# VITE_PUBLIC_APP_URL=https://webapp.ivsquarestructure.com/unit1
